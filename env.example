# ============================================================================
#  Currency-to-INR Monitoring Dashboard — Environment Configuration
#  Copy this file to ".env" and fill in the values.  NEVER commit ".env".
# ============================================================================

# ---- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Base currency for the whole application. Do not change unless you know
# exactly what you are doing — the dashboard is designed around INR.
BASE_CURRENCY=INR

# ---- Scheduler --------------------------------------------------------------
# The daily automatic update time and timezone. Uses IANA timezone names.
# 09:00 in Asia/Kolkata (IST) is the requirement.
# Change SCHEDULE_CRON to move the run time (see README "Changing the schedule").
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_CRON=0 9 * * *

# Set to "false" to disable the in-process node-cron scheduler
# (e.g. when you drive updates purely from OS cron / GitHub Actions instead).
ENABLE_INPROCESS_SCHEDULER=true

# ---- Data provider ----------------------------------------------------------
# Which provider adapter to use. One of:
#   erapi            -> open.er-api.com  (KEYLESS, real live data, works now)
#   xe               -> XE Currency Data API (PAID key required)
#   exchangerate-api -> v6.exchangerate-api.com (free/paid key, has history)
#   exchangeratehost -> exchangerate.host (key required)
# The dashboard automatically falls back to FALLBACK_PROVIDER if the primary
# one fails or has no key configured.
PROVIDER=erapi
FALLBACK_PROVIDER=erapi

# HTTP timeout (ms) and retry attempts for provider calls.
PROVIDER_TIMEOUT_MS=15000
PROVIDER_RETRIES=3
PROVIDER_RETRY_DELAY_MS=5000

# -- open.er-api.com ----------------------------------------------------------
# No key needed for the open endpoint. If you buy an ExchangeRate-API key you
# can also use the "exchangerate-api" provider below for historical backfill.
ERAPI_BASE_URL=https://open.er-api.com/v6

# -- XE Currency Data API (paid) ----------------------------------------------
# Sign up at https://www.xe.com/xecurrencydata/  -> you receive an Account ID
# and an API Key. Paste them here. Leave blank to keep XE disabled.
XE_ACCOUNT_ID=
XE_API_KEY=
XE_BASE_URL=https://xecdapi.xe.com/v1

# -- ExchangeRate-API (v6, keyed — supports historical) -----------------------
# Sign up at https://www.exchangerate-api.com/  -> paste the key here.
EXCHANGERATE_API_KEY=
EXCHANGERATE_API_BASE_URL=https://v6.exchangerate-api.com/v6

# -- exchangerate.host / apilayer (keyed) -------------------------------------
EXCHANGERATEHOST_API_KEY=
EXCHANGERATEHOST_BASE_URL=https://api.exchangerate.host

# ---- Validation thresholds --------------------------------------------------
# A day-over-day move larger than this percent is FLAGGED for review
# (not rejected). Legitimate market moves are kept but marked.
FLAG_MOVEMENT_PERCENT=15

# A move larger than this percent is treated as almost-certainly bad data and
# the value is rejected for that currency (kept as "failed", previous retained).
REJECT_MOVEMENT_PERCENT=60

# ---- Manual refresh rate limiting ------------------------------------------
# Minimum seconds between manual "Refresh Now" runs (server-side guard).
MANUAL_REFRESH_MIN_INTERVAL_SECONDS=60

# ---- Optional reference currencies (benchmarks) -----------------------------
# Comma-separated ISO codes shown as reference/benchmark rates.
REFERENCE_CURRENCIES=USD,EUR
